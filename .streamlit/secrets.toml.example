# 이 파일을 secrets.toml로 복사하고 실제 값은 이 컴퓨터에만 보관하세요.
# 계정 비밀번호, DB 연결 문자열, service_role/secret key는 여기에 넣지 않습니다.
# 선택: 외부 AI를 사용하려면 아래 최상위 항목에 개인 키를 로컬에서 설정합니다.
# 키가 있어도 기본 전송은 꺼져 있으며 매 호출 승인과 비용 설정이 필요합니다.
OPENAI_API_KEY = ""

[reviewlab]
storage = "local" # Supabase 준비/테스트 후 "supabase"로 변경 가능
supabase_url = "" # Supabase Project URL 복사 (HTTPS)
supabase_key = "" # Publishable key 또는 legacy anon key 복사
